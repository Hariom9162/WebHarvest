# MarketLens Environment Configuration Template
# Copy this file to .env to customize local settings:
# Copy-Item .env.example .env

# Base URL for scraping demonstration
SCRAPER_BASE_URL=https://books.toscrape.com/

# Scraping settings
SCRAPER_TIMEOUT_SECONDS=10
SCRAPER_MAX_PAGES=5
SCRAPER_REQUEST_DELAY_SECONDS=1.0

# User-Agent header (Polite scraping identification)
SCRAPER_USER_AGENT=MarketLensBot/1.0 (+http://localhost/research-contact)

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
